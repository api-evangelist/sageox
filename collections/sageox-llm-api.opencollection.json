{
  "opencollection": "1.0.0",
  "info": {
    "name": "SageOx Admin LLM API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "LLM",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List available models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:3000/v1/models",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all available LLM models that can be used for chat completions"
        },
        {
          "info": {
            "name": "Create chat completion",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:3000/v1/chat/completions",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a chat completion using OpenAI-compatible API format.\nSupports both streaming and non-streaming responses.\n\nFor streaming responses, set `stream: true` in the request body.\nThe response will be a text/event-stream with Server-Sent Events (SSE).\n"
        }
      ]
    }
  ],
  "bundled": true
}