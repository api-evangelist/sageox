{
  "opencollection": "1.0.0",
  "info": {
    "name": "SageOx Admin Health API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Liveness probe",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:3000/live"
          },
          "docs": "Returns basic service health status to indicate the service is running"
        },
        {
          "info": {
            "name": "Readiness probe",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:3000/ready"
          },
          "docs": "Returns detailed service readiness status including dependency health checks"
        }
      ]
    }
  ],
  "bundled": true
}