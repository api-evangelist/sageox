          "id": "7bf26333-d54d-4484-8251-4e45b4c22148",
          "name": "Create API key",
          "request": {
            "name": "Create API key",
            "description": {
              "content": "Creates a new API key for the authenticated user. The full key is returned\nonly once and must be stored securely. The key can be used for API\nauthentication via Bearer token. Optionally specify an expiration period.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "api-keys"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"<string>\",\n  \"expires_in_days\": \"<integer>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
