                "value": "",
                "type": "path",
                "description": "Team identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the status of the team's context (norms) repository.\n\n**Authentication:** Required (bearer token)\n\n**Access Control:** User must be a member of the team.\n\n**Status Values:**\n- `ready` - Context repo exists and is ready to use\n- `pending` - Context repo not yet created (auto-created during ox init)\n- `unavailable` - GitLab integration not configured\n"
        },
        {
          "info": {
            "name": "Get git checkout information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:3000/api/v1/repos/:repo_id/git/info",
            "params": [
