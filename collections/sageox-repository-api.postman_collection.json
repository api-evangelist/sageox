      "id": "a0ddbc10-9a61-4ac8-94a6-e1f91da9771e",
      "name": "Repository",
      "description": {
        "content": "Repository initialization and merge operations. `initRepo` creates or reconnects a repository with SageOx (idempotent). `mergeRepos` combines ledger data when repositories are merged.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "f9c41dd6-3981-42ce-b002-38b827f52a32",
          "name": "Initialize repository tracking",
          "request": {
            "name": "Initialize repository tracking",
            "description": {
              "content": "Registers a git repository with SageOx and creates an associated team.\n\n**Authentication:** Optional\n- **Authenticated:** User becomes owner of newly created team\n- **Unauthenticated:** Creates orphan team (can be claimed later)\n\nIdempotent: if repo_id already exists, returns existing repo/team info.\nUsers can request to merge teams via /api/v1/repo/merge.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "repo",
                "init"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"repo_id\": \"<string>\",\n  \"type\": \"<string>\",\n  \"init_at\": \"<dateTime>\",\n  \"repo_salt\": \"<string>\",\n  \"repo_remote_hashes\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"is_public\": \"<boolean>\",\n  \"created_by_email\": \"<email>\",\n  \"created_by_name\": \"<string>\"\n}",
              "options": {
                "raw": {
