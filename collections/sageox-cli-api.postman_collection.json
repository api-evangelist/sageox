      "id": "33d2ecf1-bac0-45ec-8578-9cef48c3b0e4",
      "name": "CLI",
      "description": {
        "content": "Integration endpoints for the `ox` CLI tool. Includes device flow authentication (code request → polling → token exchange), server-side diagnostics, repository initialization, and friction event tracking for UX telemetry.\n",
        "type": "text/plain"
      },
