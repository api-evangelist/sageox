                "body": {
                  "mode": "raw",
                  "raw": "",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "disabled": false,
                  "description": "Current friction collection status",
                  "key": "X-SageOx-Friction-Status",
                  "value": "active"
                },
                {
                  "disabled": false,
                  "description": "Sample rate if status is sampling (e.g., \"0.5\")",
                  "key": "X-SageOx-Sample-Rate",
                  "value": "0.5"
                },
                {
                  "disabled": false,
                  "description": "Resume time if status is paused",
                  "key": "X-SageOx-Pause-Until",
                  "value": "2025-12-18T11:30:45Z"
                },
