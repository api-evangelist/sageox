      "id": "fda65d58-318b-436f-a588-526d621613b5",
      "name": "LLM",
      "description": {
        "content": "OpenAI-compatible chat completion endpoints. Proxies requests to configured LLM providers (Bedrock, OpenAI) with model routing, token usage tracking, and streaming support. Follows the OpenAI `/v1/chat/completions` format.\n",
        "type": "text/plain"
      },
